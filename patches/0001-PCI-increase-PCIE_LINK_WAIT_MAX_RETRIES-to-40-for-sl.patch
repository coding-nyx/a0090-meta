From 4c82ed65ca8f4799acccc88f0919c449e5eb9752 Mon Sep 17 00:00:00 2001
From: Nyx <mail.me.nyx@gmail.com>
Date: Sun, 6 Sep 2026 19:24:58 +0530
Subject: [PATCH 1/2] PCI: increase PCIE_LINK_WAIT_MAX_RETRIES to 40 for
 slow-training endpoints

The RTL8168 and BCM43752 PCIe endpoints on the AMedia RK3588 LP4 V10
board (hub-11) need more than 10 retries to train the link after reset.
---
 drivers/pci/pci.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/pci/pci.h b/drivers/pci/pci.h
index 8acded59215..754974bed9a 100644
--- a/drivers/pci/pci.h
+++ b/drivers/pci/pci.h
@@ -60,7 +60,7 @@ struct pcie_tlp_log;
 #define PCIE_RESET_CONFIG_WAIT_MS	100
 
 /* Parameters for the waiting for link up routine */
-#define PCIE_LINK_WAIT_MAX_RETRIES	10
+#define PCIE_LINK_WAIT_MAX_RETRIES	40
 #define PCIE_LINK_WAIT_SLEEP_MS		90
 
 /* Message Routing (r[2:0]); PCIe r6.0, sec 2.2.8 */
-- 
2.55.0

