[connection]
id=hub11-ap
type=wifi
interface-name=wlan1
autoconnect=false

[wifi]
mode=ap
ssid=hub-11
band=a
channel=149
cloned-mac-address=preserve

[wifi-security]
key-mgmt=wpa-psk
proto=rsn
pairwise=ccmp
group=ccmp
psk=@HUB11_AP_PSK@

[ipv4]
method=shared
address1=10.42.11.1/24

[ipv6]
method=disabled
