# hub11.config — base Kconfig fragment for the AMedia RK3588 LP4 V10 board.
#
# Apply AFTER `arch/arm64/configs/defconfig` via scripts/kconfig/merge_config.sh.
# Compiled with `make olddefconfig` afterward.
#
# Required minimum: SoC, GPU, display, GbE, storage, audio, BT, Wi-Fi (PCIe).
# Conservative: most things =y so the box always reaches console and network
# even without an initramfs.

# ---- Core / SoC ----
# Deterministic release string: 6.18.N-hub11 (no -dirty / -NNNNN-gSHA).
# Scripts must export LOCALVERSION="" (set but empty) so this is not doubled.
CONFIG_LOCALVERSION="-hub11"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_ARM64=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ARCH_ROCKCHIP_3588=y

# ---- CPU / PMIC ----
CONFIG_ARM_SCMI_PROTOCOL=y
CONFIG_ARM_SCMI_POWER_DOMAIN=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_THERMAL=y
CONFIG_THERMAL_HWMON=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_MFD_RK8XX_SPI=y
CONFIG_REGULATOR_RK808=y
CONFIG_REGULATOR_FAN53555=y

# ---- IRQ / IOMMU / DMA ----
CONFIG_IOMMU_IO_PGTABLE=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_DMA_ENGINE=y
CONFIG_DMADEVICES=y
CONFIG_PL330_DMA=y

# ---- Storage ----
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_NVME=y
# zram swap (systemd-zram-generator on the box, 50% RAM, zstd)
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# ---- PCIe ----
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIE_ROCKCHIP_DW_HOST=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBPHY=y
CONFIG_PCIE_ROCKCHIP_EP=y

# ---- Wired networking (SoC GMAC + PCIe RTL8168) ----
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_STMMAC_ETH=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_REALTEK_PHY=y
CONFIG_MOTORCOMM_PHY=y
CONFIG_R8169=m
CONFIG_MDIO_BUS_MUX=y
CONFIG_MDIO_BUS_MUX_MMIOREG=y

# ---- Wireless (PCIe Broadcom BCM43752 / AP6275P) ----
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PROTO_MSGBUF=y
CONFIG_BRCMFMAC_PCIE=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# ---- Bluetooth (UART ttyS9, BCM4362A2) ----
CONFIG_BT=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL=y
CONFIG_RTC_DRV_HYM8563=y

# ---- Display / GPU (VOP2 + dw-hdmi-qp + panthor) ----
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_HDMI_QP=y
CONFIG_ROCKCHIP_DW_DP=y
CONFIG_DRM_DW_HDMI_QP=y
CONFIG_DRM_DW_HDMI_I2S_AUDIO=y
CONFIG_PHY_ROCKCHIP_SAMSUNG_HDPTX=y
CONFIG_DRM_PANTHOR=m
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_BRIDGE=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_FB=y
CONFIG_BACKLIGHT_LCD_SUPPORT=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# ---- HDMI RX capture (card rockchip,hdmiin is wired) ----
CONFIG_VIDEO_SYNOPSYS_HDMIRX=m
CONFIG_VIDEO_DEV=y
CONFIG_V4L2_MEM2MEM_DEV=m
CONFIG_VIDEO_V4L2_SUBDEV_API=y

# ---- Audio (HDMI audio + ES8388 codec; no SmartPA on board) ----
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_PCM_ELD=y
CONFIG_SND_PCM_HDMI=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=y
CONFIG_SND_SOC_ROCKCHIP_SPDIF=y
CONFIG_SND_SOC_HDMI_CODEC=m
CONFIG_SND_SOC_ES8328=m
CONFIG_SND_SOC_ES8328_I2C=m
CONFIG_SND_SIMPLE_CARD=y

# ---- Crypto / RNG ----
CONFIG_CRYPTO_DEV_ROCKCHIP=y
CONFIG_CRYPTO_DEV_ROCKCHIP_DEV=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_ROCKCHIP=y

# ---- USB ----
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_FUSB302=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
CONFIG_PHY_ROCKCHIP_USBDP=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_HID=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_NET_RNDIS_HOST=y

# ---- Sensors / input ----
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_GPIO_POLLED=y

# ---- Serial console (drop ttyFIQ0; use ttyS2 on UART2) ----
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_DWLIB=y
CONFIG_SERIAL_8250_RSA=y
CONFIG_SERIAL_OF_PLATFORM=y

# ---- TTY / PTY / FDs ----
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_UNIX98_PTYS=y

# ---- Filesystems (ext4, vfat, overlay) ----
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_HUGETLBFS=y

# ---- Crypto for userspace ----
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_RNG=y
CONFIG_CRYPTO_USER_API_AEAD=y

# ---- Security: AppArmor ----
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y

# ---- Wi-Fi vendor bcmdhd
CONFIG_WL_ROCKCHIP=m
CONFIG_WIFI_BUILD_MODULE=y
CONFIG_BCMDHD=y
CONFIG_AP6XXX=m
CONFIG_BCMDHD_PCIE=y
CONFIG_BCMDHD_STATIC_IF=y
CONFIG_BCMDHD_FW_PATH="/lib/firmware/brcm/fw_bcm43752a2_pcie_ag.bin"
CONFIG_BCMDHD_NVRAM_PATH="/lib/firmware/brcm/nvram_ap6275p.txt"
